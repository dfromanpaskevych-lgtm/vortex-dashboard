# =====================================================================
# Vortex Dashboard — Environment Variables
# Copy to .env (local dev) or set in Railway/Vercel/etc.
# =====================================================================

# === REQUIRED: Database ===============================================
# TiDB Cloud (MySQL-compatible) connection string
DATABASE_URL=mysql://user:password@host:4000/database?ssl={"rejectUnauthorized":true}

# === Auth =============================================================
# Set DISABLE_AUTH=true to skip OAuth and treat every request as admin
# (recommended for personal/team deploys on Railway).
DISABLE_AUTH=true

# Required only if DISABLE_AUTH is NOT set:
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# === Optional: AWS S3 for file uploads ================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=

# === Optional: Manus Forge (LLM / image / voice helpers) ==============
# Not required for core dashboard functionality.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# === Server ===========================================================
# Railway sets PORT automatically. Locally, default 3000.
PORT=3000
NODE_ENV=production
