{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 30
  },
  "environments": {
    "production": {
      "variables": {
        "DISABLE_AUTH": "true"
      }
    }
  }
}
